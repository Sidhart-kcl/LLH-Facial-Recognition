[Unit]
Description=MediPass Backend Service
After=network.target

[Service]
Type=simple
User=medipass
WorkingDirectory=/opt/medipass/backend
Environment="PATH=/opt/medipass/backend/venv/bin"
Environment="FLASK_DEBUG=False"
Environment="POSE_YAW_SIGN=-1"
ExecStart=/opt/medipass/backend/venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind 127.0.0.1:5050 face_service:app
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
