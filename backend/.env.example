# Local development server
FLASK_DEBUG=True
FLASK_PORT=5050
FLASK_HOST=0.0.0.0

# Face Recognition
SIMILARITY_THRESHOLD=0.45
REGISTRATION_SIMILARITY_THRESHOLD=0.20
FACE_MODEL=buffalo_l
INSIGHTFACE_HOME=~/.insightface
# Camera calibration: use -1 by default; switch to 1 if left/right are reversed
POSE_YAW_SIGN=-1

# Database
DB_PATH=./db/patients.json
CHECKIN_ATTEMPTS_PATH=./db/checkin_attempts.json
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request limits (bytes)
MAX_REQUEST_BYTES=20971520
MAX_IMAGE_BYTES=6291456

# This demo has no authentication. Do not expose it publicly or use real patient
# data until proper identity, authorization, encryption, and retention controls
# are implemented.
